# Primeiro deploy: mantenha DRY_RUN=true. Nenhuma linha será publicada ou e-mail enviado.
DRY_RUN=true
BUSINESS_TIMEZONE=America/Sao_Paulo
TRIGGER_TOKEN=

ASTER_URL=https://aster.gruposps.com.br/Login
ASTER_USERNAME=
ASTER_PASSWORD=
ASTER_USERNAME_SELECTOR=input#email
ASTER_PASSWORD_SELECTOR=input[placeholder="Senha"]
ASTER_LOGIN_BUTTON_SELECTOR=button[type="submit"]
ASTER_REPORT_URL=https://aster.gruposps.com.br/
ASTER_REPORT_READY_SELECTOR=button[data-tab-id="Reports"]
ASTER_REPORT_DOWNLOAD_SELECTOR=button[data-tip="Baixar XLSX"]
ASTER_REPORT_CARD_SELECTOR=text=Resumo Comercial
ASTER_REPORT_START_DATE_SELECTOR=
ASTER_REPORT_END_DATE_SELECTOR=
ASTER_RENDER_URL=https://grupoabr-aster-varejo.onrender.com
ASTER_RENDER_TOKEN=

# Render API authentication
TRIGGER_TOKEN=


# URL /exec do Web App publicado a partir de apps_script/SheetApiV2.gs
SHEETS_V2_URL=https://script.google.com/macros/s/AKfycbwNbMesXSQCKn67Mc_RaQ08z33r-zOc0sMylrmaqV7j9HWrXnLreby2p7vYl7ov-PH4qw/exec
SHEETS_V2_TOKEN=
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/10XOSE1z8HucS0_5K_8iX8VFg6s0ASZJwDAMfo0uacIA/edit?gid=2026090302#gid=2026090302

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_CC=

# Inteligência artificial
GROQ_ENABLED=false
ASTER_ALLOW_AI_RECOVERY=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=30
GROQ_CONFIDENCE_THRESHOLD=0.85
