ASTER_URL=https://seu-aster.exemplo.com/login
ASTER_USERNAME=seu_usuario
ASTER_PASSWORD=sua_senha

# Apos mapear o portal, substitua estes seletores pelos valores reais.
ASTER_USERNAME_SELECTOR=input[name="username"]
ASTER_PASSWORD_SELECTOR=input[name="password"]
ASTER_LOGIN_BUTTON_SELECTOR=button[type="submit"]
ASTER_REPORT_URL=https://seu-aster.exemplo.com/relatorio
ASTER_REPORT_READY_SELECTOR=body
ASTER_REPORT_TABLE_SELECTOR=table
ASTER_REPORT_DOWNLOAD_SELECTOR=
ASTER_REPORT_CARD_SELECTOR=text=Resumo Comercial
ASTER_REPORT_START_DATE_SELECTOR=form input[autocomplete="off"] >> nth=0
ASTER_REPORT_END_DATE_SELECTOR=form input[autocomplete="off"] >> nth=1
ASTER_REPORT_START_DATE=
ASTER_REPORT_END_DATE=
ASTER_POST_LOGIN_WAIT_MS=1000
ASTER_NAVIGATION_TIMEOUT_MS=30000
ASTER_HEADLESS=true

# Render e calendario de processamento.
TRIGGER_TOKEN=gere_outro_token_longo_e_aleatorio
BUSINESS_TIMEZONE=America/Sao_Paulo
REFERENCE_DATE_MODE=previous_business_day
NON_WORKING_DATES=2026-09-07,2026-10-12
EMAIL_ENABLED=true

# Endpoint publicado pelo Apps Script da planilha de metas.
SHEETS_API_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec
SHEETS_API_TOKEN=gere_um_token_longo_e_aleatorio
SHEETS_OUTPUT_TAB=1_Lançamentos Diários

SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USERNAME=seu_usuario_smtp
SMTP_PASSWORD=sua_senha_smtp
SMTP_SECURITY=starttls
MAIL_FROM=automacao@seudominio.com
MAIL_TO=destinatario@seudominio.com
MAIL_CC=
MAIL_SUBJECT=Extracao Aster ERP

OUTPUT_DIR=output
LOG_DIR=logs

# Atualizacao dos lancamentos diarios. Ative somente depois de validar os cabecalhos do CSV.
DAILY_COMPARISON_ENABLED=false
DAILY_WORKING_DAYS_REMAINING=21
ASTER_SALES_VENDOR_COLUMN=Vendedor
ASTER_SALES_QUANTITY_COLUMN=Quantidade
ASTER_SALES_DATE_COLUMN=Data
ASTER_SALES_ACCUMULATED_COLUMN=
