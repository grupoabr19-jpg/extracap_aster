# Aster ERP
ASTER_URL=https://aster.gruposps.com.br/Login
ASTER_USERNAME=seu_usuario
ASTER_PASSWORD=sua_senha
ASTER_HEADLESS=true
ASTER_NAVIGATION_TIMEOUT_MS=90000
ASTER_POST_LOGIN_WAIT_MS=1000

# Login selectors
ASTER_USERNAME_SELECTOR=input#email
ASTER_PASSWORD_SELECTOR=input[placeholder="Senha"]
ASTER_LOGIN_BUTTON_SELECTOR=button[type="submit"]

# Report navigation
ASTER_REPORT_URL=https://aster.gruposps.com.br/
ASTER_REPORT_READY_SELECTOR=button[data-tab-id="Reports"]
ASTER_REPORT_CARD_SELECTOR=text=Resumo Comercial
# Deixe vazio para resolver por tipo, rotulo e atributos do campo na SPA.
ASTER_REPORT_START_DATE_SELECTOR=
ASTER_REPORT_END_DATE_SELECTOR=
ASTER_REPORT_CONFIRM_SELECTOR=button:has-text("Confirmar")
ASTER_REPORT_DOWNLOAD_SELECTOR=button[data-tip="Baixar XLSX"]
ASTER_REPORT_TABLE_SELECTOR=table
ASTER_REPORT_START_DATE=
ASTER_REPORT_END_DATE=

# Columns in the Aster commercial summary
ASTER_SALES_VENDOR_COLUMN=Vendedor
ASTER_SALES_QUANTITY_COLUMN=Peso total
ASTER_SALES_DATE_COLUMN=
ASTER_SALES_ACCUMULATED_COLUMN=

# Google Apps Script API
SHEETS_API_URL=https://script.google.com/macros/s/seu_deployment_id/exec
SHEETS_API_TOKEN=gere_um_token_forte
SHEETS_OUTPUT_TAB=1_Lançamentos Diários

# Render API authentication
TRIGGER_TOKEN=gere_um_token_forte_diferente

# E-mail delivery
SMTP_HOST=smtp.seu_provedor.com
SMTP_PORT=587
SMTP_USERNAME=seu_email
SMTP_PASSWORD=sua_senha_ou_app_password
SMTP_SECURITY=starttls
MAIL_FROM=seu_email
MAIL_TO=destinatario@exemplo.com
MAIL_CC=
MAIL_SUBJECT=Extracao Aster ERP

# Processing options
DAILY_COMPARISON_ENABLED=true
DAILY_WORKING_DAYS_REMAINING=21
OUTPUT_DIR=output
LOG_DIR=logs

# Render provides PORT automatically. This value is useful only for local runs.
PORT=8080

# Groq fallback. Use um modelo de producao suportado pelo Groq.
GROQ_MODEL=llama-3.1-8b-instant
